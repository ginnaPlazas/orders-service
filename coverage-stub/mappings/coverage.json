{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/coverage/validate",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.destination.cityId == 999999)]" }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "valid": false,
          "reason": "MUNICIPALITY_NOT_FOUND",
          "message": "El municipio de destino no existe en la API Colombia"
        }
      }
    },
    {
      "priority": 5,
      "request": {
        "method": "POST",
        "url": "/coverage/validate"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "valid": true,
          "zone": "REST_OF_COUNTRY",
          "fare": { "amount": 15000, "currency": "COP" }
        }
      }
    }
  ]
}